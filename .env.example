# Servisin dinleyecegi port
PORT=8080

# /admin altindaki yonetim API'sini korumak icin kullanilan anahtar.
# Istek header'inda "x-api-key: <bu deger>" olarak gonderilmeli.
# Prod'a cikmadan mutlaka degistirin.
ADMIN_API_KEY=degistir-bu-anahtari

# SQLite veritabani dosyasinin yolu
DB_PATH=./data/pdks.sqlite
